// server.js
require("dotenv").config();
const express = require("express");
const { z } = require("zod");
const cors = require("cors");
const bcrypt = require("bcryptjs");
const jwt = require("jsonwebtoken");
const prisma = require('./prismaClient');
const tenantMiddleware = require('./middleware/prisma-middleware');

// request-scoped context helper (preserve your existing logic)
const requestContext = new WeakMap();
function setRequestContext(req, ctx) { requestContext.set(req, ctx); }
function getRequestContext(req) { return requestContext.get(req); }

// register tenant middleware so each request gets req.prisma
app.use(tenantMiddleware());


// Auth middleware: verifies JWT and sets tenant/outlet/user on req
function authMiddleware(req, res, next) {
  const authHeader = req.headers.authorization;
  if (!authHeader?.startsWith("Bearer ")) return next(); // allow anonymous where needed

  const token = authHeader.slice(7);
  try {
    const payload = jwt.verify(token, process.env.JWT_SECRET);
    // expected payload shape: { sub: "<userId>", tenantId: "...", outletId: "...", role: "TENANT_ADMIN", exp: ... }
    req.auth = {
      userId: payload.sub,
      tenantId: payload.tenantId,
      outletId: payload.outletId,
      role: payload.role
    };
    // Set context for prisma middleware using the request-scoped context holder
    setRequestContext(req, {
      tenantId: req.auth.tenantId,
      outletId: req.auth.outletId,
      userId: req.auth.userId
    });
    next();
  } catch (err) {
    return res.status(401).json({ error: "Invalid token" });
  }
}

// Middleware to store current request in a global (for prisma middleware access)
app.use((req, res, next) => { global.__CURRENT_REQUEST = req; next(); });

app.use(authMiddleware);

// Example protected route
app.get("/me", async (req, res) => {
  if (!req.auth?.userId) return res.status(401).json({ error: "Unauthorized" });
  const user = await prisma.user.findUnique({ where: { id: req.auth.userId }});
  res.json({ user });
});

// --- Zod Schema for Login ---
const loginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1, "Password is required"),
});

// --- Login Endpoint ---
app.post("/login", async (req, res) => {
  const validation = loginSchema.safeParse(req.body);
  if (!validation.success) {
    return res.status(400).json({ error: "Invalid input", details: validation.error.issues });
  }

  const { email, password } = validation.data;

  const user = await prisma.user.findUnique({ where: { email } });

  if (!user) {
    return res.status(401).json({ error: "Invalid credentials" });
  }

  const isPasswordValid = await bcrypt.compare(password, user.password);

  if (!isPasswordValid) {
    return res.status(401).json({ error: "Invalid credentials" });
  }

  // Create JWT payload
  const payload = {
    sub: user.id,
    tenantId: user.tenantId,
    outletId: user.outletId,
    role: user.role,
  };

  const token = jwt.sign(payload, process.env.JWT_SECRET, { expiresIn: "1d" });
  res.json({ token });
});

// --- Zod Schema for User Registration ---
const registerUserSchema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  password: z.string().min(6, "Password must be at least 6 characters long"),
  role: z.enum(["TENANT_ADMIN", "MANAGER", "STAFF"]).optional().default("STAFF"),
});

// --- Register User Endpoint ---
// This is a protected route, only an existing admin/manager can create new users.
app.post("/register", async (req, res) => {
  // Authorization: Ensure the user making the request is an ADMIN or MANAGER
  if (!req.auth || !['TENANT_ADMIN', 'MANAGER', 'SUPERADMIN'].includes(req.auth.role)) {
    return res.status(403).json({ error: "Forbidden: You do not have permission to create users." });
  }

  const validation = registerUserSchema.safeParse(req.body);
  if (!validation.success) {
    return res.status(400).json({ error: "Invalid input", details: validation.error.issues });
  }

  const { name, email, password, role } = validation.data;

  try {
    const hashedPassword = await bcrypt.hash(password, 10);

    const newUser = await prisma.user.create({
      data: {
        name,
        email,
        password: hashedPassword,
        role,
        tenantId: req.auth.tenantId, // New user belongs to the creator's tenant
        outletId: req.auth.outletId, // And creator's outlet
      },
    });

    // Don't send the password back, even if it's hashed
    const { password: _, ...userWithoutPassword } = newUser;
    res.status(201).json(userWithoutPassword);
  } catch (error) {
    // Prisma's P2002 code is for unique constraint violations
    if (error.code === 'P2002' && error.meta?.target?.includes('email')) {
      return res.status(409).json({ error: "A user with this email already exists." });
    }
    console.error("Registration error:", error);
    res.status(500).json({ error: "Failed to register user." });
  }
});

// --- Zod Schema for Order Creation ---
const createOrderSchema = z.object({
  type: z.enum(["DINE_IN", "TAKEAWAY", "DELIVERY"]),
  customerName: z.string().optional(),
  items: z.array(z.object({
    menuItemId: z.number().int(),
    quantity: z.number().int().positive(),
  })).min(1), // Ensure there's at least one item
});

// Example create order endpoint (tenant-scoped)
app.post("/orders", async (req, res) => {
  if (!req.auth?.tenantId) return res.status(403).json({ error: "Tenant context missing" });

  // 1. Validate input
  const validation = createOrderSchema.safeParse(req.body);
  if (!validation.success) {
    return res.status(400).json({ error: "Invalid input", details: validation.error.issues });
  }

  const { items, type, customerName } = validation.data;

  // 2. Security: Don't trust prices from the client. Fetch them from the database.
  const menuItemIds = items.map(item => item.menuItemId);
  const menuItemsFromDb = await prisma.menuItem.findMany({
    where: {
      id: { in: menuItemIds },
      tenantId: req.auth.tenantId // Ensure items belong to the tenant
    }
  });

  // 3. Prepare order data and calculate totals
  const orderItemsToCreate = items.map(item => {
    const menuItem = menuItemsFromDb.find(dbItem => dbItem.id === item.menuItemId);
    // This check ensures all requested items were found in the DB for this tenant
    if (!menuItem) {
      // We use a specific error type that can be caught below
      const error = new Error(`Menu item with ID ${item.menuItemId} not found or does not belong to this tenant.`);
      error.name = 'ItemValidationError';
      throw error;
    }
    return {
      menuItemId: item.menuItemId,
      quantity: item.quantity,
      price: menuItem.price // Use the price from the database
    };
  });

  const subtotal = orderItemsToCreate.reduce((acc, item) => {
    // item.price is a Decimal object, so we convert it to a number for calculation
    return acc + (item.quantity * Number(item.price));
  }, 0);

  try {
    const order = await prisma.order.create({
      data: {
        tenantId: req.auth.tenantId,
        outletId: req.auth.outletId ?? undefined,
        type,
        subtotal: subtotal,
        finalTotal: subtotal, // Assuming no discount for now
        customerName,
        items: { create: orderItemsToCreate }
      },
      include: { items: true }
    });
    res.status(201).json(order);
  } catch (e) {
    console.error(e);
    // Provide a more specific error if our item validation check failed
    if (e.name === 'ItemValidationError') {
      return res.status(400).json({ error: e.message });
    }
    res.status(500).json({ error: "Failed to create order." });
  }
});

const port = process.env.PORT || 3001; // Changed to 3001 to match frontend
app.listen(port, () => console.log(`Listening on ${port}`));
