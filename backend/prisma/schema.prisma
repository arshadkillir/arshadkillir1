generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TENANCY / ORGANIZATION
model Tenant {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  outlets Outlet[]
  users   User[]
  settings TenantSetting[]
  menuTemplates MenuTemplate[]
}

// OUTLETS (locations)
model Outlet {
  id        String    @id @default(cuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  users           User[]
  floors          Floor[]
  menuCategories  MenuCategory[]
  orders          Order[]
  deliveryConfigs DeliveryAggregatorConfig[]
  ingredients     Ingredient[]
  inventories     Inventory[]
  journalEntries  JournalEntry[]
  menuItems       OutletMenuItem[]
  inventory       OutletInventory[]
  shifts          Shift[]
}

// USERS (tenant-scoped; tenantId nullable for platform SUPERADMIN)
model User {
  id        String   @id @default(cuid())
  tenantId  String?
  outletId  String? // For staff/managers assigned to a specific outlet
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true) // For deactivating users
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  outlet Outlet? @relation(fields: [outletId], references: [id])
  shifts Shift[]
}

enum Role {
  SUPERADMIN
  OWNER
  MANAGER
  STAFF
}

// FLOORS & TABLE SETUP
model Floor {
  id       String @id @default(cuid())
  outletId String
  name     String

  outlet Outlet  @relation(fields: [outletId], references: [id])
  tables Table[]
}

model Table {
  id      String @id @default(cuid())
  name    String
  seats   Int    @default(4)
  floorId String

  floor  Floor   @relation(fields: [floorId], references: [id])
  orders Order[]
}

// MENU
model MenuCategory {
  id       String @id @default(cuid())
  outletId String
  name     String

  outlet Outlet     @relation(fields: [outletId], references: [id])
  items  MenuItem[]
}

model MenuItem {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean @default(true)

  category    MenuCategory         @relation(fields: [categoryId], references: [id])
  variants    MenuVariant[]
  ingredients MenuItemIngredient[]
  orderItems  OrderItem[]
  outletMenuItems OutletMenuItem[]
}

model MenuVariant {
  id         String @id @default(cuid())
  menuItemId String
  name       String
  price      Float
  
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  orderItems OrderItem[]
}

// TENANT SETTINGS
model TenantSetting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

// MENU TEMPLATES (tenant-scoped)
model MenuTemplate {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Define relation to menu items if needed
}


// INGREDIENTS & INVENTORY
model Ingredient {
  id       String @id @default(cuid())
  outletId String
  name     String
  unit     String // kg, g, L, ml
  cost     Float

  outlet      Outlet               @relation(fields: [outletId], references: [id])
  menuItems   MenuItemIngredient[]
  inventories Inventory[]
  outletInventories OutletInventory[]
}

model MenuItemIngredient {
  id           String @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float // e.g. 0.05 kg

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model Inventory {
  id           String   @id @default(cuid())
  outletId     String
  ingredientId String
  quantity     Float // current stock
  updatedAt    DateTime @updatedAt

  outlet     Outlet     @relation(fields: [outletId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

// OUTLET-SPECIFIC MENU OVERRIDES
model OutletMenuItem {
  id         String  @id @default(cuid())
  outletId   String
  menuItemId String
  price      Float?
  isAvailable Boolean?

  outlet   Outlet   @relation(fields: [outletId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([outletId, menuItemId])
}

//
// ORDERS
model Order {
  id        String      @id @default(cuid())
  tenantId  String
  outletId  String
  tableId   String?
  type      OrderType   @default(DINE_IN)
  status    OrderStatus @default(PENDING)
  subtotal  Float       @default(0)
  finalTotal Float      @default(0)
  customerName String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  outlet Outlet      @relation(fields: [outletId], references: [id])
  table  Table?      @relation(fields: [tableId], references: [id])
  items  OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  variantId  String?
  quantity   Int
  price      Float

  order    Order        @relation(fields: [orderId], references: [id])
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id])
  variant  MenuVariant? @relation(fields: [variantId], references: [id])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// DELIVERY CONFIG
model DeliveryAggregatorConfig {
  id       String  @id @default(cuid())
  outletId String
  name     String // Talabat, Careem, Noon
  apiKey   String?
  isActive Boolean @default(true)

  outlet Outlet @relation(fields: [outletId], references: [id])
}

// ACCOUNTING / JOURNAL
model JournalEntry {
  id          String   @id @default(cuid())
  outletId    String
  description String
  amount      Float
  createdAt   DateTime @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id])
}

// OUTLET INVENTORY (physical counts per outlet)
model OutletInventory {
  id           String   @id @default(cuid())
  outletId     String
  ingredientId String
  quantity     Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlet     Outlet     @relation(fields: [outletId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

// SHIFTS (cash/shift management)
model Shift {
  id        String    @id @default(cuid())
  outletId  String
  userId    String
  startAt   DateTime  @default(now())
  endAt     DateTime?
  startCash Float
  endCash   Float?

  outlet Outlet @relation(fields: [outletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// CUSTOMERS
model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}