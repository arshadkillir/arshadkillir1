# .env

# PostgreSQL Database Configuration
# The name of the database to be created by Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=posdb

# The connection string for the backend application.
# The database name here MUST match POSTGRES_DB above.
DATABASE_URL=postgresql://postgres:postgres@db:5432/posdb?schema=public

# Application Configuration
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-that-is-long-and-secure