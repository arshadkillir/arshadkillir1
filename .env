# This is used by docker-compose to configure the containers
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_pass
POSTGRES_DB=posdb

# The backend CONTAINER needs "@db" to find the database inside Docker
DATABASE_URL="postgresql://pos_user:pos_pass@db:5432/posdb?schema=public"
JWT_SECRET=your-super-secret-and-long-random-string-for-jwt