generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]
  users   User[]
  menus   MenuTemplate[]
  settings TenantSetting[]
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?  @unique
  address   String?
  phone     String?
  open      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventories OutletInventory[]
  orders      Order[]
  shifts      Shift[]

  @@index([tenantId])
  @@index([code])
}

model User {
  id         String   @id @default(cuid())
  tenantId   String? 
  email      String
  name       String
  password   String
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdOrders Order[] @relation("order_createdBy")
  assignedShifts Shift[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model MenuTemplate {
  id          Int     @id @default(autoincrement())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories  Category[]

  @@index([tenantId])
}

model Category {
  id             Int     @id @default(autoincrement())
  menuTemplateId Int
  name           String
  menuTemplate   MenuTemplate @relation(fields: [menuTemplateId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]

  @@index([menuTemplateId])
}

model MenuItem {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  name          String
  description   String?
  basePrice     Decimal  @db.Decimal(10,2)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  outletOverrides OutletMenuItem[]
  orderItems    OrderItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model OutletMenuItem {
  id          Int      @id @default(autoincrement())
  outletId    String
  menuItemId  Int
  price       Decimal? @db.Decimal(10,2)
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, menuItemId])
  @@index([outletId])
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  outletId      String?
  type          OrderType
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12,2)
  discount      Decimal?    @db.Decimal(12,2) @default(0)
  tax           Decimal?    @db.Decimal(12,2) @default(0)
  finalTotal    Decimal     @db.Decimal(12,2)
  customerName  String?
  customerPhone String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("order_createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([tenantId])
  @@index([outletId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  menuItemId Int
  quantity   Decimal         @db.Decimal(10,3)
  unitPrice  Decimal         @db.Decimal(12,2)
  status     OrderItemStatus @default(PENDING)
  createdAt  DateTime        @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OutletInventory {
  id        Int      @id @default(autoincrement())
  outletId  String
  tenantId  String
  itemName  String
  sku       String?
  quantity  Decimal  @db.Decimal(12,3)
  unit      String
  updatedAt DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([tenantId])
  @@unique([outletId, sku], map: "uniq_outlet_sku")
}

model Shift {
  id         String   @id @default(cuid())
  outletId   String
  tenantId   String
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  openedById String?
  closedById String?
  state      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, phone], map: "uniq_tenant_phone")
  @@unique([tenantId, email], map: "uniq_tenant_email")
}

