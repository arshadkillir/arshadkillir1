import React, { useState, useEffect } from 'react';
import API from '@/services/api.js';
import { subDays, format } from 'date-fns';
import { Bar, Pie } from 'react-chartjs-2';
import Papa from 'papaparse';
import { Chart as ChartJS, CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend, ArcElement } from 'chart.js';
import styles from './Dashboard.module.css';

ChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend, ArcElement);

export default function Dashboard() {
  const [report, setReport] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [startDate, setStartDate] = useState(format(subDays(new Date(), 30), 'yyyy-MM-dd'));
  const [endDate, setEndDate] = useState(format(new Date(), 'yyyy-MM-dd'));

  useEffect(() => {
    const fetchReport = async () => {
      try {
        setLoading(true);
        const response = await API.get(`/reports/sales?startDate=${startDate}&endDate=${endDate}`);
        setReport(response.data);
      } catch (err) {
        setError('Failed to load sales report.');
        console.error(err);
      } finally {
        setLoading(false);
      }
    };
    fetchReport();
  }, [startDate, endDate]);

  const chartData = {
    labels: report?.salesByDay.map(d => new Date(d.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })) || [],
    datasets: [
      {
        label: 'Daily Sales ($)',
        data: report?.salesByDay.map(d => Number(d.total)) || [],
        backgroundColor: 'rgba(30, 144, 255, 0.6)',
        borderColor: 'rgba(30, 144, 255, 1)',
        borderWidth: 1,
      },
    ],
  };

  const chartOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'top',
      },
      title: {
        display: true,
        text: `Sales from ${startDate} to ${endDate}`,
      },
    },
  };

  const pieChartData = {
    labels: report?.salesByType.map(t => t.type.replace('_', ' ')) || [],
    datasets: [
      {
        label: 'Sales by Type',
        data: report?.salesByType.map(t => Number(t._sum.total)) || [],
        backgroundColor: [
          'rgba(30, 144, 255, 0.8)',
          'rgba(40, 167, 69, 0.8)',
          'rgba(255, 193, 7, 0.8)',
        ],
        borderColor: [
          'rgba(30, 144, 255, 1)',
          'rgba(40, 167, 69, 1)',
          'rgba(255, 193, 7, 1)',
        ],
        borderWidth: 1,
      },
    ],
  };

  const handleExport = () => {
    if (!report || !report.salesByDay) return;

    const dataToExport = report.salesByDay.map(day => ({
      Date: new Date(day.date).toLocaleDateString('en-CA'), // YYYY-MM-DD format
      'Total Sales': Number(day.total).toFixed(2),
    }));

    const csv = Papa.unparse(dataToExport);
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.setAttribute('href', url);
    link.setAttribute('download', `sales_report_${startDate}_to_${endDate}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  if (loading) return <p>Loading dashboard...</p>;
  if (error) return <p style={{ color: 'red' }}>{error}</p>;
  if (!report) return <p>No report data available for the selected period.</p>;

  return (
    <div>
      <h1>Sales Dashboard</h1>
      <div className={`${styles.card} ${styles.dateFilterCard}`}>
        <label>From:</label>
        <input type="date" value={startDate} onChange={e => setStartDate(e.target.value)} className={styles.dateInput} />
        <label>To:</label>
        <input type="date" value={endDate} onChange={e => setEndDate(e.target.value)} className={styles.dateInput} />
        <button onClick={handleExport} className={styles.exportButton}>
          Export to CSV
        </button>
      </div>

      <div className={styles.metricsGrid}>
        {/* Key Metrics */}
        <div className={`${styles.card} ${styles.metricCard}`}>
          <h3>Total Revenue</h3>
          <p className={styles.metricValue}>
            ${Number(report.totalSales).toFixed(2)}
          </p>
          <span className={styles.metricLabel}>Selected Period</span>
        </div>
        <div className={`${styles.card} ${styles.metricCard}`}>
          <h3>Gross Profit</h3>
          <p className={`${styles.metricValue} ${report.grossProfit >= 0 ? styles.metricValuePositive : styles.metricValueNegative}`}>
            ${Number(report.grossProfit).toFixed(2)}
          </p>
          <span className={styles.metricLabel}>Sales - Purchases</span>
        </div>
        <div className={`${styles.card} ${styles.metricCard}`}>
          <h3>Total Purchases</h3>
          <p className={styles.metricValue}>
            ${Number(report.totalPurchases).toFixed(2)}
          </p>
          <span className={styles.metricLabel}>Selected Period</span>
        </div>

        <div className={`${styles.card} ${styles.metricCard}`}>
          <h3>Est. Inventory Value</h3>
          <p className={styles.metricValue}>
            ${Number(report.inventoryValue).toFixed(2)}
          </p>
          <span className={styles.metricLabel}>Based on item cost</span>
        </div>
        {/* Top Performers */}
        <div className={`${styles.card} ${styles.fullWidthCard}`}>
          <h3>Top Selling Items</h3>
          <ol className={styles.list}>
            {report.topSellingItems.map((item, index) => (
              <li key={index} className={styles.listItem}>
                {item.name} - <strong>{item.quantity} sold</strong>
              </li>
            ))}
          </ol>
        </div>

        <div className={`${styles.card} ${styles.fullWidthCard}`}>
          <h3>Top Performing Staff</h3>
          <ol className={styles.list}>
            {report.salesByStaff.map((staff, index) => (
              <li key={index} className={styles.listItem}>
                {staff.staffName} - <strong>${Number(staff.totalSales).toFixed(2)}</strong> from {staff.orderCount} orders
              </li>
            ))}
          </ol>
        </div>

        <div className={`${styles.card} ${styles.fullWidthCard}`}>
          <h3>Top Performing Tables</h3>
          <ol className={styles.list}>
            {report.salesByTable.map((table, index) => (
              <li key={index} className={styles.listItem}>
                {table.tableName} - <strong>${Number(table.totalSales).toFixed(2)}</strong>
              </li>
            ))}
          </ol>
        </div>

        <div className={`${styles.card} ${styles.fullWidthCard}`}>
          <h3>Top Customers</h3>
          <ol className={styles.list}>
            {report.topCustomers.map((customer, index) => (
              <li key={index} className={styles.listItem}>
                {customer.name || 'N/A'} ({customer.phone}) - <strong>${Number(customer.totalSpent).toFixed(2)}</strong> from {customer.orderCount} orders
              </li>
            ))}
          </ol>
        </div>

        <div className={`${styles.card} ${styles.fullWidthCard} ${styles.lowStockCard}`}>
          <h3>Low Stock Alert</h3>
          {report.lowStockItems.length > 0 ? (
            <ul className={styles.list}>
              {report.lowStockItems.map((item, index) => (
                <li key={index} className={`${styles.listItem} ${styles.lowStockItem}`}>
                  {item.name} - <strong>{item.qtyOnHand}</strong> remaining (Min: {item.minLevel})
                </li>
              ))}
            </ul>
          ) : <p>All inventory levels are healthy.</p>}
        </div>
      </div>

      <div className={styles.chartsGrid}>
        <div className={styles.card}>
          <Bar options={chartOptions} data={chartData} />
        </div>
        <div className={`${styles.card} ${styles.pieChartCard}`}>
          <h3>Sales by Order Type</h3>
          <Pie data={pieChartData} />
        </div>
      </div>
    </div>
  );
}